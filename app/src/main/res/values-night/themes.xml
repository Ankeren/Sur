         phone is in dark mode, so we only override the status bar. -->
    <style name="Theme.Sur" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#8AB4E8</item>
        <item name="colorOnPrimary">#10233A</item>
        <item name="colorSecondary">@color/sur_accent</item>
        <item name="android:statusBarColor">#10233A</item>
    </style>
</resources>
